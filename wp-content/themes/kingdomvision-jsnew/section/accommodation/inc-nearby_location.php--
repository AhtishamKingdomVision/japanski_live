<?php 
echo '<section class="full-section nearby_location" '.BackgroundFromSection($section).'>';
    echo '<div class="container">';
        echo TitleFromSection($section);

        if (!empty($locations)) {

            echo '<div class="nearby-wrapper">';

            /* ========================================================
            MAP AREA (Replaced with Leaflet Plugin Shortcode execution)
            ======================================================== */
            echo '<div class="nearby-map-area">';
                
                // 1. Build the base map shortcode using your main hotel fields
                $map_shortcode = sprintf(
                    '[leaflet-map id="nearby-map" lat="%s" lng="%s" zoom="15" scrollwheel="true"]',
                    esc_attr($main_lat),
                    esc_attr($main_lng)
                );

                // 2. Build the primary hotel location marker with its popup info
                $map_shortcode .= sprintf(
                    '[leaflet-marker lat="%s" lng="%s"]<strong>%s</strong><br>%s[/leaflet-marker]',
                    esc_attr($main_lat),
                    esc_attr($main_lng),
                    esc_html($main_title),
                    esc_html($main_address)
                );

                // 3. Dynamically loop through your custom ACF landmarks and add markers
                $mapArray = [];
                foreach ($locations as $i => $loc) {
                    $title = $loc['title'] ?? '';
                    $lat = $loc['latitude'] ?? '';
                    $lng = $loc['longitude'] ?? '';
                    $base_area = $loc['base_area'] ?? '';
                    $km = is_array( $road_km ) ? ( $road_km[ $i ] ?? null ) : null;

                    if ( $km === null ) {
                        $km = nearby_location_distance_km( $main_lat, $main_lng, $lat, $lng );
                    }

                    if (!empty($lat) && !empty($lng)) {
                        $map_shortcode .= sprintf(
                            '[leaflet-marker lat="%s" lng="%s" id="marker-%d"]<strong>%s</strong><br>%s km away[/leaflet-marker]',
                            esc_attr($lat),
                            esc_attr($lng),
                            $i,
                            esc_html($title),
                            esc_html($km)
                        );
                    }

                    $mapArray[] = [
                        'title' => $title,
                        'km'    => $km,
                        'lat'   => $lat,
                        'lng'   => $lng,
                    ];
                }

                // 4. Force WordPress to process the generated shortcode bundle strings
                echo do_shortcode($map_shortcode);

                echo '
                    <div id="main-location-box" class="main-location-box">
                        <h4>' . esc_html($main_title) . '</h4>
                        <p>' . esc_html($main_address) . '</p>
                    </div>
                ';
                
                echo '<button type="button" class="location-info-btn" id="open-location-info"> More Location Info </button>';
            echo '</div>';

            /* =========================
            SIDEBAR LIST
            ========================= */
            echo '<div class="nearby-list-box">';
                echo '<h3 class="nearby-title">Closest Landmarks</h3>';
                echo '<ul class="nearby-list">';

                    foreach ($locations as $i => $loc) {
                        $title = $loc['title'] ?? '';
                        $lat = $loc['latitude'] ?? '';
                        $lng = $loc['longitude'] ?? '';
                        $base_area = $loc['base_area'] ?? '';
                        $km = $mapArray[$i]['km'] ?? '';

                        $term_name = '';
                        if ( ! empty( $base_area ) ) {
                            $term = get_term( $base_area, 'accommodation-cat' );
                            $term_name = ( $term && ! is_wp_error( $term ) ) ? $term->name : '';
                        }

                        $title_html = esc_html( $title );
                        if ( $term_name !== '' ) {
                            $title_html .= ' <span class="badge">' . esc_html( $term_name ) . '</span>';
                        }

                        echo '
                            <li class="nearby-item" data-index="' . $i . '" data-lat="' . esc_attr($lat) . '" data-lng="' . esc_attr($lng) . '">
                                <span class="nearby-label">' . $title_html . '</span>
                                <span class="distance">' . esc_html($km) . ' km</span>
                            </li>';
                    }

                echo '</ul>';
            echo '</div>'; // list-box

            echo '</div>'; // wrapper

            /* ========================================================
            SIDEBAR INTERACTION CONTROLLER (Binds list clicks to plugin map)
            ======================================================== */
            echo '<script data-no-optimize="1" data-no-defer="1" data-cfasync="false">
                document.addEventListener("DOMContentLoaded", function () {
                    if (typeof jQuery !== "undefined") {
                        if (jQuery("ul.nearby-list li.nearby-item").length < 1) {
                            jQuery("section.nearby_location").hide();
                            return;
                        } else {
                            jQuery("section.nearby_location").show();
                        }
                    }

                    // Handles jumping/panning the plugin map when a landmark sidebar item is clicked
                    document.querySelectorAll(".nearby-item").forEach(function(el) {
                        el.addEventListener("click", function() {
                            var lat = parseFloat(this.dataset.lat);
                            var lng = parseFloat(this.dataset.lng);
                            var index = this.dataset.index;

                            // Accesses the Leaflet map instances globally exposed by the plugin engine
                            if (typeof window.WPLeafletMapPlugin !== "undefined" && window.WPLeafletMapPlugin.maps) {
                                var maps = window.WPLeafletMapPlugin.maps;
                                var targetMap = maps["nearby-map"] || Object.values(maps)[0];
                                
                                if (targetMap && !isNaN(lat) && !isNaN(lng)) {
                                    targetMap.setView([lat, lng], 16);
                                    
                                    // Highlights the clicked sidebar node
                                    document.querySelectorAll(".nearby-item").forEach(i => i.classList.remove("active"));
                                    el.classList.add("active");
                                }
                            }
                        });
                    });
                });
            </script>';
        }

        $acc_details = get_field('accomodation_details');
        $address = $acc_details['address'] ?? '';
        if($address){
            echo '<button type="button" class="acc-address acc-address-map-trigger" aria-haspopup="dialog" aria-controls="accommodation-map-modal">';
                echo '<span><img class="address_pointer" src="'.get_template_directory_uri(). '/images/add-pointer.svg'.'">' . esc_html($address) .'</span>';
            echo '</button>';
        }
    echo '</div>';
echo '</section>';