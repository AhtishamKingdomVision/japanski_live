{"title":"success","message":"Properties found successfully","properties":[{"PropertyId":1,"AccommodationSetting":[{"id":23,"commission_level":15,"markup_level":null,"commission_level_type":"%","deposits_enabled":true,"first_night_fee":"no","night_fee_value":0,"percentage_value":true,"deposit_amount_per_room":25,"min_deposit_jpy":0,"days_in_advance":60,"description":null,"taxes_fees":0,"price_mode":"","price":0,"allow_pro_rata_pricing":false,"duration_nights":0,"maximum_quantity":0,"refundable_type":"percentage","refundable_value":0,"refundable_min_days":0,"date_rules":null,"is_fixed_date_enabled":false,"fixed_deadline_date":null,"due_on_confirm_booking_date":null,"due_on_confirm_booking":"no","created_at":"2026-01-29T03:42:59.000000Z","updated_at":"2026-02-04T05:56:24.000000Z","pivot":{"supplier_id":21,"accommodation_setting_id":23}}],"SupplierPaymentTerms":{"isDeposit":true,"isPercentage":true,"depositPercentage":25,"depositType":"deposit","depositAmount":0,"balanceDueAmount":0,"daysInAdv":60,"daysInAdvDate":null,"isFixedDate":false,"fixedDueDate":null,"balanceDueDate":null,"date_rules":[]},"PropertyRoomBossHotelId":"2c98902a50a6076e0150b6d1d6f0651d","PropertyName":"AYA Niseko","ClientPropertyName":"AYA Niseko","PropertyDescription":"<p>AYA Niseko sits at the base of NISEKO TOKYU Grand HIRAFU\u2019s most popular ski runs, offering a ski-in ski-out experience. Onsen and sauna in the common area. Ski valet\/AYA Spa\/Gym\/Nomad wellness Physio. No kitchen in Atelier. \nNISEKO TOKYU Grand HIRAFU ski resort is scheduled to open till 6 MAY 2026. <\/p>","PropertyClientDescription":"<p><span style=\"background-color: rgb(255, 255, 255); color: rgb(51, 51, 51);\">AYA Niseko is located&nbsp;on the Grand Hirafu Resort. ski slope, with immediate connection to the lifts.&nbsp;Incorporating all the services expected from a high-end hotel, the experienced and dedicated team of&nbsp;hotel staff&nbsp;provide 24-hour reception, with in-house&nbsp;amenities including concierge,&nbsp;ski valet,&nbsp;natural&nbsp;<\/span><em style=\"background-color: rgb(255, 255, 255); color: rgb(51, 51, 51);\">onsen<\/em><span style=\"background-color: rgb(255, 255, 255); color: rgb(51, 51, 51);\">&nbsp;hot springs, private family&nbsp;<\/span><em style=\"background-color: rgb(255, 255, 255); color: rgb(51, 51, 51);\">onsens<\/em><span style=\"background-color: rgb(255, 255, 255); color: rgb(51, 51, 51);\">, spa and massage, gym, restaurant, bar, art gallery,&nbsp;craft shop, kid\u2019s club, ski school, conference room and more.qwerty<\/span><\/p>","PropertyBedBankDesc":null,"PropertyCountry":"Japan","NoOfRooms":null,"AddressOne":"4-ch\u014dme-4-5 Nisekohirafu 1 J\u014d, Kutchan, Abuta District, Hokkaido 044-0080, Japan","LinkWithRB":true,"LiftAccessInfo":"Ski in Ski out of Ace Family Lift (please check lift operation during off-peak).","LocationInfo":"AYA Niseko proudly sits at the base of one of Grand Hirafu\u2019s most popular ski runs, providing an unparalleled ski in ski out experience during winter. This superb location means that your Niseko Japan accommodation is never more than minutes away from any of Hirafu\u2019s award-winning restaurants, bars and shops, making it the perfect Niseko hotel. After a day skiing, simply ski in and drop your equipment with the ski valet for an evening of private outdoor onsen and dining within AYA complex, or take a short stroll into the heart of Hirafu village to dine out.","ResortName":"Niseko","ResortShortCode":"NSK","PropertyType":"hotel","PropertySubType":"roomboss","NoOfBedRooms":"","MaxChildAge":"","Units":[{"Unit":1,"Adults":2,"Children":0,"Infants":0,"Rooms":[{"RoomId":"20260724130100413","ActualRoomId":"2c98902a50a6076e0150b72b40126f67","DBRoomId":3,"RoomName":"Studio Village View","RoomDescription":"2~6th Flr. 47 sqm. Up to 3 ppl ( 7 years old and up ). Sofa-bed for 3rd person.  Ensuite bathroom includes shower (no bathtub). Modern studio overlooking the town. Custom furnished, w\/ plentiful seating and living space, kitchenette, refrigerator, TV and more. Washer\/dryers are available in common laundry rooms.","BedBankDesc":null,"ClientRoomName":"Studio Village View","ClientRoomDescription":"Studio Village View Room Features: 47 sqm apartment comprising of combined bedroom and living area, 1 bathroom, and kitchenette. Sleeps up to 2 people on twin\/king size beds and 1 person on sofa bed at the standard rate.","ChildAveragePrice":"","ChildrenPrice":"","AdditionalChildren":2,"AdditionalInfants":3,"Facilities":{"name":"Unit Facilities","category_id":10,"options":[{"id":291,"icon":"<i class=\"fa-solid fa-kitchen-set\"><\/i>","name":"Kitchenette","checked":true},{"id":308,"icon":"<i class=\"fa-solid fa-temperature-high\"><\/i>","name":"Heated floors","checked":true},{"id":57,"icon":"<i class=\"fa-solid fa-tv\"><\/i>","name":"Flat Screen TV","checked":true},{"id":309,"icon":"<i class=\"fa-solid fa-tv\"><\/i>","name":"Satellite TV","checked":true},{"id":37,"icon":"<i class=\"fa-solid fa-mug-hot\"><\/i>","name":"Kettle","checked":true},{"id":36,"icon":"<i class=\"fa-solid fa-fire-burner\"><\/i>","name":"Rice Cooker","checked":true},{"id":32,"icon":"<i class=\"fa-solid fa-snowflake\"><\/i>","name":"Fridge","checked":true},{"id":314,"icon":"<i class=\"fa-solid fa-bottle-water\"><\/i>","name":"Toiletries","checked":true},{"id":74,"icon":"<i class=\"fa-solid fa-phone\"><\/i>","name":"Telephone","checked":true},{"id":46,"icon":"<i class=\"fa-solid fa-wind\"><\/i>","name":"Hair Dryer","checked":true},{"id":40,"icon":"<i class=\"fa-solid fa-mug-hot\"><\/i>","name":"Tea Bags","checked":true},{"id":44,"icon":"<i class=\"fa-solid fa-utensils\"><\/i>","name":"Utensils","checked":true},{"id":20,"icon":"<i class=\"fa-solid fa-pump-soap\"><\/i>","name":"Shampoo","checked":true},{"id":21,"icon":"<i class=\"fa-solid fa-pump-soap\"><\/i>","name":"Conditioner","checked":true},{"id":22,"icon":"<i class=\"fa-solid fa-pump-soap\"><\/i>","name":"Body Soap","checked":true},{"id":23,"icon":"<i clas